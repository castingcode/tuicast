{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castingcode.github.io/tuicast/schema/mcp-profiles.schema.json",
  "title": "TUICast MCP profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["profiles"],
  "properties": {
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$"
      },
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "terminal", "width", "height"],
      "properties": {
        "description": { "type": "string" },
        "protocol": { "enum": ["ssh", "telnet", "pty"] },
        "address": { "type": "string", "minLength": 1 },
        "terminal": { "enum": ["vt220", "xterm-256color"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "ssh": { "$ref": "#/$defs/ssh" },
        "pty": { "$ref": "#/$defs/pty" }
      },
      "allOf": [
        {
          "if": { "properties": { "protocol": { "const": "ssh" } } },
          "then": { "required": ["ssh"] },
          "else": { "not": { "required": ["ssh"] } }
        },
        {
          "if": { "properties": { "protocol": { "const": "pty" } } },
          "then": { "required": ["pty"], "not": { "required": ["address"] } },
          "else": { "required": ["address"], "not": { "required": ["pty"] } }
        }
      ]
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username"],
      "properties": {
        "username": { "type": "string", "minLength": 1 },
        "passwordEnv": { "type": "string", "minLength": 1 },
        "privateKeyFile": { "type": "string", "minLength": 1 },
        "privateKeyPassphraseEnv": { "type": "string", "minLength": 1 },
        "knownHostsFile": { "type": "string", "minLength": 1 },
        "hostKeyFingerprint": { "type": "string", "minLength": 1 },
        "insecureSkipHostKeyCheck": { "const": true },
        "connectTimeoutMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "allOf": [
        {
          "anyOf": [
            { "required": ["passwordEnv"] },
            { "required": ["privateKeyFile"] }
          ]
        },
        {
          "oneOf": [
            { "required": ["knownHostsFile"] },
            { "required": ["hostKeyFingerprint"] },
            { "required": ["insecureSkipHostKeyCheck"] }
          ]
        },
        {
          "if": { "required": ["privateKeyPassphraseEnv"] },
          "then": { "required": ["privateKeyFile"] }
        }
      ]
    },
    "pty": {
      "description": "Runs a local program on a pseudo-terminal. tuicast-mcp accepts PTY profiles only when started with -allow-pty.",
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "description": "A path containing a separator is resolved from the configuration file's directory; a bare name is looked up on PATH.",
          "type": "string",
          "minLength": 1
        },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "workingDirectory": {
          "description": "Resolved from the configuration file's directory when relative.",
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/environmentName" },
          "additionalProperties": { "type": "string" }
        },
        "environmentFromSecrets": {
          "description": "Maps a program environment variable to a secret name, resolved like passwordEnv.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/environmentName" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "clearEnvironment": { "type": "boolean" }
      }
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[^=]+$",
      "not": { "const": "TERM" }
    }
  }
}
