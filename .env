# Non-secret settings shared by the reference TUI and the examples.
#
# Passwords never belong in this file. Copy .env.example to .env.local, which
# Git ignores, and set them there. Load both files into your shell with:
#
#   set -a; . ./.env; . ./.env.local; set +a
TUICAST_REFERENCE_ADDRESS=127.0.0.1:2222
TUICAST_REFERENCE_TELNET_ADDRESS=127.0.0.1:2323
