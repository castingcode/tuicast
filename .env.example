# Copy this file to .env.local, which Git ignores, and choose your own values.
# For example, generate each password with: openssl rand -hex 16
#
# The reference TUI requires these passwords and has no defaults. The examples
# read the same variables to connect and log in.

# SSH password for the reference TUI's SSH server.
TUICAST_REFERENCE_PASSWORD=

# Password accepted by the reference application's login screen.
TUICAST_REFERENCE_APP_PASSWORD=
